# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production-use-random-32-chars

# ─── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=evaluser
POSTGRES_PASSWORD=evalpassword
POSTGRES_DB=evaldb
DATABASE_URL=postgresql://evaluser:evalpassword@localhost:5432/evaldb

# ─── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── LLM Configuration ──────────────────────────────────────────────────────────
# PRIMARY: Google Gemini (Free tier — 1500 requests/day)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# OPTIONAL OVERRIDE: Set this to use OpenAI instead of Gemini
# OPENAI_API_KEY=your-openai-api-key-here

# LLM provider: "gemini" (default) or "openai"
LLM_PROVIDER=gemini

# Which model to use (change based on provider)
LLM_MODEL=gemini-1.5-flash

# If true, returns mock LLM responses (no API key needed — useful for testing)
LLM_MOCK_MODE=false

# ─── Evaluation Settings ────────────────────────────────────────────────────────
# Latency threshold in ms above which a warning is raised
LATENCY_THRESHOLD_MS=1000

# Number of recent evaluations to scan for failure patterns
PATTERN_SCAN_WINDOW=100

# Minimum confidence to auto-label (below this = route to human review)
AUTO_LABEL_CONFIDENCE_THRESHOLD=0.8

# Cohen's Kappa threshold below which annotators are considered disagreeing
ANNOTATOR_AGREEMENT_THRESHOLD=0.6

# ─── Frontend ──────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
